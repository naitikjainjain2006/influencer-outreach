# --- Discovery ---
YOUTUBE_API_KEY=

# --- AI personalization (optional; falls back to dynamic templates if unset) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Email sending (only needed with `send --live`) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=        # Gmail: use an App Password, never your real password
SENDER_EMAIL=
